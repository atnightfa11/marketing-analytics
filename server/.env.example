DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
UPLOAD_TOKEN_SECRET=dev-secret-change-me
UPLOAD_TOKEN_TTL_SECONDS=900
UPLOAD_TOKEN_PURGE_GRACE_SECONDS=86400
UPLOAD_TOKEN_PURGE_INTERVAL_SECONDS=300
MIN_REPORTS_PER_WINDOW=40
LIVE_WATERMARK_SECONDS=120
MAX_OUT_OF_ORDER_SECONDS=300
RATE_LIMIT_BUCKET_PER_MIN=200
ALPHA_SMOOTHING=0.5
MAX_EVENTS_PER_MINUTE=60
SESSION_HMAC_SECRET=change-me-standard-session-secret
SESSION_WINDOW_MINUTES=30
SESSION_HMAC_IP_PREFIX_V4=24
SESSION_HMAC_IP_PREFIX_V6=56
BOT_FILTER_ENABLED=true
BOT_FILTER_MIN_CF_SCORE=30
BOT_FILTER_UA_PATTERNS_CSV=
GEOIP_COUNTRY_DB_PATH=/tmp/geoip-country.mmdb
GEOIP_COUNTRY_DB_URL=https://download.db-ip.com/free/dbip-country-lite-{year_month}.mmdb.gz
GEOIP_COUNTRY_DB_DOWNLOAD_TIMEOUT_SECONDS=20
CORS_ORIGINS_CSV=https://validanalytics.io,https://app.validanalytics.io
CORS_ALLOW_ALL=false
ENABLE_PRO_INGEST=false
ENABLE_PROD_SCHEDULER=true
PROD_SCHEDULER_HOUR_UTC=2
FORECAST_HORIZON_DAYS=90
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD=change-me-dashboard-password
DASHBOARD_AUTH_SECRET=change-me-dashboard-jwt-secret
DASHBOARD_ALLOW_UNCLAIMED_SITES=false
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_STANDARD_PRICE_ID=price_change_me
STRIPE_PRO_PRICE_ID=price_change_me_optional
STRIPE_CHECKOUT_SUCCESS_URL=https://app.validanalytics.io/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://app.validanalytics.io/billing/cancel
STRIPE_SIGNUP_SUCCESS_URL=https://validanalytics.io/signup/complete
STRIPE_SIGNUP_CANCEL_URL=https://validanalytics.io/signup
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;
