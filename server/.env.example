DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
APP_ENV=development
VALID_PROCESS_TYPE=api
UPLOAD_TOKEN_SECRET=dev-secret-change-me
UPLOAD_TOKEN_TTL_SECONDS=900
UPLOAD_TOKEN_PURGE_GRACE_SECONDS=86400
UPLOAD_TOKEN_PURGE_INTERVAL_SECONDS=300
MIN_REPORTS_PER_WINDOW=40
LIVE_WATERMARK_SECONDS=120
MAX_OUT_OF_ORDER_SECONDS=300
RATE_LIMIT_BUCKET_PER_MIN=200
ALPHA_SMOOTHING=0.5
MAX_EVENTS_PER_MINUTE=60
SESSION_HMAC_SECRET=change-me-standard-session-secret
SESSION_WINDOW_MINUTES=30
SESSION_HMAC_IP_PREFIX_V4=32
SESSION_HMAC_IP_PREFIX_V6=64
BOT_FILTER_ENABLED=true
BOT_FILTER_MIN_CF_SCORE=30
BOT_FILTER_UA_PATTERNS_CSV=
GEOIP_COUNTRY_DB_PATH=/tmp/geoip-country.mmdb
GEOIP_COUNTRY_DB_URL=https://download.db-ip.com/free/dbip-country-lite-{year_month}.mmdb.gz
GEOIP_COUNTRY_DB_DOWNLOAD_TIMEOUT_SECONDS=20
# Public SDK ingest CORS. Keep broad for customer websites; ingest endpoints do
# not use cookies and still enforce token/origin checks.
CORS_ORIGINS_CSV=https://validanalytics.io,https://app.validanalytics.io
CORS_ALLOW_ALL=false
# Credentialed dashboard CORS. Include only trusted app/marketing/dev origins
# that may send the dashboard HttpOnly session cookie.
DASHBOARD_CORS_ORIGINS_CSV=https://validanalytics.io,https://app.validanalytics.io
ENABLE_PRO_INGEST=false
ENABLE_PROD_SCHEDULER=true
PROD_SCHEDULER_HOUR_UTC=2
FORECAST_HORIZON_DAYS=90
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_SECRET=change-me-dashboard-jwt-secret
DASHBOARD_AUTH_COOKIE_NAME=valid_dashboard_session
# Leave unset to infer true in APP_ENV=production and false in local/dev.
# DASHBOARD_AUTH_COOKIE_SECURE=
DASHBOARD_AUTH_COOKIE_SAMESITE=lax
DASHBOARD_ALLOW_UNCLAIMED_SITES=false
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_SOLO_PRICE_ID=price_change_me_solo
STRIPE_STANDARD_PRICE_ID=price_change_me
STRIPE_EARLY_ADOPTER_STANDARD_PRICE_ID=price_change_me_optional
STRIPE_PRO_PRICE_ID=price_change_me_optional
STRIPE_CHECKOUT_SUCCESS_URL=https://app.validanalytics.io/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://app.validanalytics.io/billing/cancel
STRIPE_SIGNUP_SUCCESS_URL=https://validanalytics.io/signup/complete
STRIPE_SIGNUP_CANCEL_URL=https://validanalytics.io/signup
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;
# Admin + ingest tokens. COLLECT_ENDPOINT_TOKEN is required for /api/collect and no
# longer falls back to ADMIN_API_TOKEN, so it must be set independently.
ADMIN_API_TOKEN=change-me-admin-api-token
COLLECT_ENDPOINT_TOKEN=change-me-collect-endpoint-token
# Shared secret required to POST /api/alert/webhook (sent as X-Alert-Token).
ALERT_WEBHOOK_TOKEN=change-me-alert-webhook-token
# Optional protected Prometheus scrape endpoint. Leave token empty to hide /metrics.
METRICS_PUBLIC=false
METRICS_AUTH_TOKEN=
# Optional internal ops alert destinations for reducer/forecast/API failures.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_EMAIL_RECIPIENTS_CSV=
OPS_ALERT_DEDUP_SECONDS=300
# Per-IP login throttle (attempts/minute); set 0 to disable.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Optional SMTP settings for customer-facing anomaly alert emails.
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USERNAME=
ALERT_EMAIL_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_USE_TLS=true
